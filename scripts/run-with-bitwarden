#!/bin/sh
set -eu

# Bitwarden не разблокируется при запуске: приложение само спросит мастер-пароль
# и поднимет bw serve на этом порту при первой синхронизации.
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"
port=${ZER0_GOPASS_BITWARDEN_PORT:-8088}
ZER0_GOPASS_BITWARDEN_URL=http://127.0.0.1:$port exec go run ./cmd/zer0-gopass-tui
